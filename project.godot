; Engine configuration file.
; Itapema City RPG | protótipo mobile
config_version=5

[application]

config/name="Itapema City RPG"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Jogo imobiliário experimental ambientado em uma Itapema estilizada"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.49, 0.78, 0.96, 1)
